{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "block",
          "content": {
            "mod": "better-sidebar",
            "props": {
              "view": "lists"
            }
          },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "better-sidebar",
            "props": {
              "view": "footer"
            }
          },
          "size": {
            "px": 37
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "size": {
            "px": 42
          },
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "better-tabs",
                "props": {
                  "rememberPanels": {
                    "container": "panel",
                    "stack": "panel-body"
                  },
                  "buttons": [
                    {
                      "id": "files",
                      "label": "Files",
                      "icon": "file",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "label": "Changes",
                      "icon": "changes",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "changes"
                      }
                    },
                    {
                      "id": "prs",
                      "label": "PRs",
                      "icon": "mods/branch-pr/icons/pull-request.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "pull-requests"
                      }
                    },
                    {
                      "id": "issues",
                      "label": "Issues",
                      "icon": "mods/branch-issue/icons/issue.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "linear-issues"
                      }
                    }
                  ]
                }
              },
              "size": {
                "weight": 1
              },
              "window_drag": true
            },
            {
              "id": "panel-toggle",
              "type": "block",
              "size": {
                "px": 36
              },
              "content": {
                "mod": "better-sidebar",
                "props": {
                  "view": "panel-toggle"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "better-changes"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "better-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "better-changes"
                      }
                    },
                    {
                      "id": "pull-requests",
                      "type": "block",
                      "content": {
                        "mod": "branch-pr"
                      }
                    },
                    {
                      "id": "linear-issues",
                      "type": "block",
                      "content": {
                        "mod": "branch-issue"
                      }
                    }
                  ],
                  "active": "changes"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
